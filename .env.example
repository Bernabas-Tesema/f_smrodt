GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional standby provider for SMROD AI engine (Docker backend).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Project Configuration (Auth, PostgreSQL Database & Storage)
# Project Ref: tobexeirhbjehfwrojty
VITE_SUPABASE_URL="https://tobexeirhbjehfwrojty.supabase.co"
VITE_SUPABASE_REST_URL="https://tobexeirhbjehfwrojty.supabase.co/rest/v1"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# Server-only Supabase keys (Docker / Django)
SUPABASE_URL="https://tobexeirhbjehfwrojty.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWT_SECRET="paste-from-supabase-settings-api-jwt-secret"

# Django REST Gateway
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# ---------------------------------------------------------------------------
# Supabase Auth email verification (SMTP)
# Configure in Supabase Dashboard → Project Settings → Authentication → SMTP
# (or Auth → Emails). Flutter cannot inject SMTP credentials; Supabase sends
# the confirmation / reset emails using the SMTP you configure there.
#
# Recommended (Gmail app password / SendGrid / Mailgun / Resend):
#   Host: smtp.gmail.com   Port: 587   TLS: on
#   User: your@gmail.com
#   Pass: app password (not your normal password)
#
# Also set Auth → URL Configuration → Redirect URLs to include your app
# origins (e.g. http://localhost:* and production domain).
# Confirm "Enable email confirmations" under Auth → Providers → Email.

# PostgreSQL (used by docker compose `db` + Django)
DB_ENGINE=postgresql
DB_NAME=smrod_db
DB_USER=postgres
DB_PASSWORD=smrod_local_dev_2026!
DB_HOST=db
DB_PORT=5432
